iffSnippet","lines":[{"text":"    ): Agent? = detectAgent(FakeEnvironment(mapOf(*env), existingFiles, stdoutIsTerminal))","oldLineNum":null,"newLineNum":35},{"text":"","oldLineNum":null,"newLineNum":36},{"text":"    @Test","oldLineNum":null,"newLineNum":37},{"text":"    fun `detection can be disabled explicitly`() {","oldLineNum":null,"newLineNum":38},{"text":"        assertFalse(detect(\"KOTLIN_TOOLCHAIN_AGENT_DETECTION_ENABLED\" to \"false\", \"AI_AGENT\" to \"claude_code\"))","oldLineNum":null,"newLineNum":39},{"text":"        assertFalse(detect(\"KOTLIN_TOOLCHAIN_AGENT_DETECTION_ENABLED\" to \"FALSE\", \"CURSOR_AGENT\" to \"1\"))","oldLineNum":null,"newLineNum":40},{"text":"        assertTrue(detect(\"KOTLIN_TOOLCHAIN_AGENT_DETECTION_ENABLED\" to \"true\", \"AI_AGENT\" to \"claude_code\"))","oldLineNum":null,"newLineNum":41},{"text":"    }","oldLineNum":null,"newLineNum":42},{"text":"","oldLineNum":null,"newLineNum":43},{"text":"    @Test","oldLineNum":null,"newLineNum":44}]}}},"id":"F8uLI0W60zc"},{"details":{"className":"CodeDiscussionAddedFeedEvent","codeDiscussion":{"id":"4MBfmc39vNTH","anchor":{"repository":"amper","revision":"7911192f78f11d24353110ba1f3f074de5f451e5","filename":"/sources/libraries/agent-detection/src/org/jetbrains/amper/agentdetection/KnownAgents.kt","line":64,"oldLine":null},"endAnchor":{"revision":"7911192f78f11d24353110ba1f3f074de5f451e5","line":90,"oldLine":null},"channel":{"id":"2dpFm33zgtiT"},"resolvable":true,"resolved":true,"snippet":{"className":"CodeDiscussionSnippet.InlineDiffSnippet","lines":[{"text":" * Keep in sync with [agents.json](https://github.com/vercel/detect-agent/blob/main/agents.json).","oldLineNum":null,"newLineNum":62},{"text":" */","oldLineNum":null,"newLineNum":63},{"text":"internal fun AgentDetectionEnvironment.detectAgentByMarkers(): Agent? = when {","oldLineNum":null,"newLineNum":64},{"text":"    isAnySet(\"CURSOR_TRACE_ID\") -> Agent.Cursor","oldLineNum":null,"newLineNum":65},{"text":"    isAnySet(\"CURSOR_AGENT\") || getEnv(\"CURSOR_EXTENSION_HOST_ROLE\") == \"agent-exec\" -> Agent.CursorCli","oldLineNum":null,"newLineNum":66},{"text":"    // KIMI_CODE_HOME may be configured outside an active session, so we rely on the plugin-scoped marker","oldLineNum":null,"newLineNum":67},{"text":"    isAnySet(\"KIMI_PLUGIN_ROOT\") -> Agent.Kimi","oldLineNum":null,"newLineNum":68},{"text":"    isAnySet(\"GROK_PLUGIN_ROOT\", \"GROK_PLUGIN_DATA\") -> Agent.Grok","oldLineNum":null,"newLineNum":69},{"text":"    isAnySet(\"GEMINI_CLI\") -> Agent.GeminiCli","oldLineNum":null,"newLineNum":70},{"text":"    isAnySet(\"CLINE_ACTIVE\") -> Agent.Cline","oldLineNum":null,"newLineNum":71},{"text":"    isAnySet(\"CODEX_SANDBOX\", \"CODEX_CI\", \"CODEX_THREAD_ID\", \"CODEX_SANDBOX_NETWORK_DISABLED\") -> Agent.Codex","oldLineNum":null,"newLineNum":72},{"text":"    isAnySet(\"ANTIGRAVITY_AGENT\", \"ANTIGRAVITY_CLI_ALIAS\") -> Agent.Antigravity","oldLineNum":null,"newLineNum":73},{"text":"    isAnySet(\"AUGMENT_AGENT\") -> Agent.AugmentCli","oldLineNum":null,"newLineNum":74},{"text":"    isAnySet(\"OPENCODE_CLIENT\", \"OPENCODE\") -> Agent.OpenCode","oldLineNum":null,"newLineNum":75},{"text":"    isAnySet(\"GOOSE_PROVIDER\") -> Agent.Goose","oldLineNum":null,"newLineNum":76},{"text":"    isAnySet(\"JUNIE_DATA\", \"JUNIE_SHIM_PATH\") -> Agent.Junie","oldLineNum":null,"newLineNum":77},{"text":"    // Pi has no dedicated variable, but it prepends its '.pi/agent' directory to the PATH","oldLineNum":null,"newLineNum":78},{"text":"    getEnv(\"PATH\").orEmpty().contains(PiAgentDirectoryInPath) -> Agent.Pi","oldLineNum":null,"newLineNum":79},{"text":"    // Claude Code (and Claude Cowork, which also sets these markers)","oldLineNum":null,"newLineNum":80},{"text":"    isAnySet(\"CLAUDECODE\", \"CLAUDE_CODE\") -> Agent.ClaudeCode","oldLineNum":null,"newLineNum":81},{"text":"    isAnySet(\"REPL_ID\") -> Agent.Replit","oldLineNum":null,"newLineNum":82},{"text":"    isAnySet(\"COPILOT_MODEL\", \"COPILOT_ALLOW_ALL\", \"COPILOT_GITHUB_TOKEN\") -> Agent.GitHubCopilot","oldLineNum":null,"newLineNum":83},{"text":"    // TERM_PROGRAM=kiro is set by both the IDE terminal and the CLI agent, so we also require no TTY to avoid","oldLineNum":null,"newLineNum":84},{"text":"    // detecting a human using the integrated terminal","oldLineNum":null,"newLineNum":85},{"text":"    \"kiro\" in getEnv(\"TERM_PROGRAM\").orEmpty() && !isStdoutTerminal() -> Agent.Kiro","oldLineNum":null,"newLineNum":86},{"text":"    isAnySet(\"OPENCLAW_SHELL\") -> Agent.OpenClaw","oldLineNum":null,"newLineNum":87},{"text":"    fileExists(DevinMarkerFile) -> Agent.Devin","oldLineNum":null,"newLineNum":88},{"text":"    else -> null","oldLineNum":null,"newLineNum":89},{"text":"}","oldLineNum":null,"newLineNum":90},{"text":"","oldLineNum":null,"newLineNum":91},{"text":"/** Returns true if any of the environment variables [names] is set and non-empty. */","oldLineNum":null,"newLineNum":92}]}}},"id":"F8uLK0W60ze"},{"details":{"className":"MCMessage"},"id":"F8uLv0W6107"},{"details":{"className":"CodeDiscussionAddedFeedEvent","codeDiscussion":{"id":"upnmQ12gTjt","anchor":{"repository":"amper","revision":"7911192f78f11d24353110ba1f3f074de5f451e5","filename":"/sources/libraries/agent-detection/src/org/jetbrains/amper/agentdetection/KnownAgents.kt","line":56,"oldLine":null},"endAnchor":{"revision":"7911192f78f11d24353110ba1f3f074de5f451e5","line":57,"oldLine":null},"channel":{"id":"hWNMW09ujko"},"resolvable":true,"resolved":true,"snippet":{"className":"CodeDiscussionSnippet.InlineDiffSnippet","lines":[{"text":"    Agent.entries.filter { it != Agent.Other }.associateBy { it.aiAgentName } + AgentNameAliases","oldLineNum":null,"newLineNum":54},{"text":"","oldLineNum":null,"newLineNum":55},{"text":"/** Returns the agent that declared itself with the given [AI_AGENT][name] value, or [Agent.Other] if unknown. */","oldLineNum":null,"newLineNum":56},{"text":"internal fun agentByDeclaredName(name: String): Agent = KnownAgentNames[na