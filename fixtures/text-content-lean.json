{"type":"TEXT","lines":[{"text":"/*"},{"text":" * Copyright 2000-2026 JetBrains s.r.o. and contributors. Use of this source code is governed by the Apache 2.0 license."},{"text":" */"},{"text":""},{"text":"package org.jetbrains.amper.agentdetection"},{"text":""},{"text":"import kotlin.io.path.Path"},{"text":""},{"text":"private val PiAgentDirectoryInPath = Regex(\"\"\"\\.pi[\\\\/]agent\"\"\")"},{"text":"private val DevinMarkerFile = Path(\"/opt/.devin\")"},{"text":""},{"text":"/**"},{"text":" * An AI agent that can run command-line tools."},{"text":" *"},{"text":" * @property aiAgentName the canonical value of the `AI_AGENT` variable that identifies this agent."},{"text":" * See the [AI_AGENT standard](https://github.com/vercel/detect-agent#the-ai_agent-standard)."},{"text":" */"},{"text":"enum class Agent(val aiAgentName: String) {"},{"text":"    Cursor(\"cursor\"),"},{"text":"    CursorCli(\"cursor-cli\"),"},{"text":"    Kimi(\"kimi\"),"},{"text":"    Grok(\"grok\"),"},{"text":"    GeminiCli(\"gemini_cli\"),"},{"text":"    Cline(\"cline\"),"},{"text":"    Codex(\"codex_cli\"),"},{"text":"    Antigravity(\"antigravity\"),"},{"text":"    AugmentCli(\"augment-cli\"),"},{"text":"    OpenCode(\"open_code\"),"},{"text":"    Goose(\"goose\"),"},{"text":"    Junie(\"junie\"),"},{"text":"    Pi(\"pi\"),"},{"text":"    ClaudeCode(\"claude_code\"),"},{"text":"    Replit(\"replit\"),"},{"text":"    GitHubCopilot(\"github-copilot\"),"},{"text":"    Kiro(\"kiro\"),"},{"text":"    OpenClaw(\"openclaw\"),"},{"text":"    Devin(\"devin\"),"},{"text":""},{"text":"    /** An agent that we don't know specifically, but that identified itself via the `AI_AGENT` variable. */"},{"text":"    Other(\"other\"),"},{"text":"}"},{"text":""},{"text":"/** Other accepted (lowercase) `AI_AGENT` values, in addition to the canonical [Agent.aiAgentName]s. */"},{"text":"private val AgentNameAliases: Map<String, Agent> = mapOf("},{"text":"    \"gemini-cli\" to Agent.GeminiCli,"},{"text":"    \"codex\" to Agent.Codex,"},{"text":"    \"codex-cli\" to Agent.Codex,"},{"text":"    \"openai/codex\" to Agent.Codex,"},{"text":"    \"opencode\" to Agent.OpenCode,"},{"text":"    \"claude-code\" to Agent.ClaudeCode,"},{"text":"    \"claude\" to Agent.ClaudeCode,"},{"text":")"},{"text":""},{"text":"private val KnownAgentNames: Map<String, Agent> ="},{"text":"    Agent.entries.filter { it != Agent.Other }.associateBy { it.aiAgentName } + AgentNameAliases"},{"text":""},{"text":"/** Returns the agent that declared itself with the given [AI_AGENT][name] value, or [Agent.Other] if unknown. */"},{"text":"internal fun agentByDeclaredName(name: String): Agent = KnownAgentNames[name.lowercase()] ?: Agent.Other"},{"text":""},{"text":"/**"},{"text":" * Returns the known agent whose markers are present in the environment, or null if there are none."},{"text":" *"},{"text":" * Keep in sync with [agents.json](https://github.com/vercel/detect-agent/blob/main/agents.json)."},{"text":" */"},{"text":"internal fun AgentDetectionEnvironment.detectAgentByMarkers(): Agent? = when {"},{"text":"    isAnySet(\"CURSOR_TRACE_ID\") -> Agent.Cursor"},{"text":"    isAnySet(\"CURSOR_AGENT\") || getEnv(\"CURSOR_EXTENSION_HOST_ROLE\") == \"agent-exec\" -> Agent.CursorCli"},{"text":"    // KIMI_CODE_HOME may be configured outside an active session, so we rely on the plugin-scoped marker"},{"text":"    isAnySet(\"KIMI_PLUGIN_ROOT\") -> Agent.Kimi"},{"text":"    isAnySet(\"GROK_PLUGIN_ROOT\", \"GROK_PLUGIN_DATA\") -> Agent.Grok"},{"text":"    isAnySet(\"GEMINI_CLI\") -> Agent.GeminiCli"},{"text":"    isAnySet(\"CLINE_ACTIVE\") -> Agent.Cline"},{"text":"    isAnySet(\"CODEX_SANDBOX\", \"CODEX_CI\", \"CODEX_THREAD_ID\", \"CODEX_SANDBOX_NETWORK_DISABLED\") -> Agent.Codex"},{"text":"    isAnySet(\"ANTIGRAVITY_AGENT\", \"ANTIGRAVITY_CLI_ALIAS\") -> Agent.Antigravity"},{"text":"    isAnySet(\"AUGMENT_AGENT\") -> Agent.AugmentCli"},{"text":"    isAnySet(\"OPENCODE_CLIENT\", \"OPENCODE\") -> Agent.OpenCode"},{"text":"    isAnySet(\"GOOSE_PROVIDER\") -> Agent.Goose"},{"text":"    isAnySet(\"JUNIE_DATA\", \"JUNIE_SHIM_PATH\") -> Agent.Junie"},{"text":"    // Pi has no dedicated variable, but it prepends its '.pi/agent' directory to the PATH"},{"text":"    getEnv(\"PATH\").orEmpty().contains(PiAgentDirectoryInPath) -> Agent.Pi"},{"text":"    // Claude Code (and Claude Cowork, which also sets these markers)"},{"text":"    isAnySet(\"CLAUDECODE\", \"CLAUDE_CODE\") -> Agent.ClaudeCode"},{"text":"    isAnySet(\"REPL_ID\") -> Agent.Replit"},{"text":"    isAnySet(\"COPILOT_MODEL\", \"COPILOT_ALLOW_ALL\", \"COPILOT_GITHUB_TOKEN\") -> Agent.GitHubCopilot"},{"text":"    // TERM_PROGRAM=kiro is set by both the IDE terminal and the CLI agent, so we also require no TTY to avoid"},{"text":"    // detecting a human using the integrated terminal"},{"text":"    \"kiro\" in getEnv(\"TERM_PROGRAM\").orEmpty() && !isStdoutTerminal() -> Agent.Kiro"},{"text":"    isAnySet(\"OPENCLAW_SHELL\") -> Agent.OpenClaw"},{"text":"    fileExists(DevinMarkerFile) -> Agent.Devin"},{"text":"    else -> null"},{"text":"}"},{"text":""},{"text":"/** Returns true if any of the environment variables [names] is set and non-empty. */"},{"text":"private fun AgentDetectionEnvironment.isAnySet(vararg names: String): Boolean ="},{"text":"    names.any { !getEnv(it).isNullOrEmpty() }"},{"text":""}]}