{
  "name": "jetbrains-space-cli",
  "version": "0.1.1",
  "description": "Narrow-scope CLI for coding agents to read, answer, and resolve JetBrains Space code review comments",
  "type": "module",
  "bin": {
    "space-cli": "dist/bin/space-cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && vitest run"
  },
  "keywords": [
    "jetbrains",
    "space",
    "code-review",
    "cli"
  ],
  "license": "MIT",
  "author": "Anton Prokhorov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singleton11/space-cli.git"
  },
  "bugs": {
    "url": "https://github.com/singleton11/space-cli/issues"
  },
  "homepage": "https://github.com/singleton11/space-cli#readme",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "commander": "^15.0.0"
  }
}
